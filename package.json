{
  "name": "guildscribe",
  "version": "0.2.0",
  "description": "A self-hosted Discord voice meeting recorder",
  "type": "module",
  "bin": {
    "guildscribe": "dist/index.js"
  },
  "files": [
    "dist/",
    "docs/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "commander": "15.0.0",
    "discord.js": "^14.27.0",
    "opusscript": "0.0.8",
    "prism-media": "1.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
