{
  "name": "guildscribe",
  "version": "1.5.1",
  "description": "A self-hosted Discord voice meeting recorder",
  "type": "module",
  "bin": {
    "guildscribe": "dist/index.js"
  },
  "files": [
    "dist/",
    "docs/spec.md",
    "scripts/daemon",
    "scripts/installLaunchAgent.sh",
    "scripts/uninstallLaunchAgent.sh",
    "scripts/upgradeGlobal.sh",
    "scripts/uninstallGlobal.sh",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "contracts:update": "npm run build && node scripts/updateContractSnapshots.mjs",
    "package:npm": "node scripts/packageRelease.mjs",
    "package:release": "npm run package:npm",
    "prepack": "npm run build",
    "test:package": "node scripts/testPackage.mjs",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@discordjs/voice": "0.19.2",
    "better-sqlite3": "12.10.0",
    "commander": "15.0.0",
    "discord.js": "^14.27.0",
    "opusscript": "0.0.8",
    "prism-media": "1.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
