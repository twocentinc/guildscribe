{
  "contractVersion": 1,
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "version": {
        "type": "number",
        "const": 1
      },
      "scope": {
        "type": "string"
      },
      "key": {
        "minItems": 1,
        "maxItems": 3,
        "type": "array",
        "items": {
          "type": [
            "string",
            "number"
          ]
        }
      }
    },
    "required": [
      "version",
      "scope",
      "key"
    ],
    "additionalProperties": false
  }
}
