{
  "contractVersion": 1,
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "language": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "segments": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "startOffsetMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "endOffsetMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "text": {
              "type": "string"
            },
            "sourceIntervalID": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "startOffsetMs",
            "endOffsetMs",
            "text"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "language",
      "segments"
    ],
    "additionalProperties": false
  }
}
