{
  "contractVersion": 1,
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "number",
            "const": 1
          },
          "intervalID": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "recordingID": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "startOffsetMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "endOffsetMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "incomplete": {
            "type": "boolean"
          },
          "kind": {
            "type": "string",
            "const": "speaking"
          },
          "userID": {
            "type": "string",
            "pattern": "^\\d{17,20}$"
          }
        },
        "required": [
          "schemaVersion",
          "intervalID",
          "recordingID",
          "startOffsetMs",
          "endOffsetMs",
          "incomplete",
          "kind",
          "userID"
        ],
        "additionalProperties": false
      },
      {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "number",
            "const": 1
          },
          "intervalID": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "recordingID": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "startOffsetMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "endOffsetMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "incomplete": {
            "type": "boolean"
          },
          "kind": {
            "type": "string",
            "const": "connectionGap"
          },
          "reason": {
            "type": "string",
            "const": "voiceDisconnected"
          }
        },
        "required": [
          "schemaVersion",
          "intervalID",
          "recordingID",
          "startOffsetMs",
          "endOffsetMs",
          "incomplete",
          "kind",
          "reason"
        ],
        "additionalProperties": false
      }
    ]
  }
}
