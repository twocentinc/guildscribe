{
  "contractVersion": 1,
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "version": {
        "type": "number",
        "const": 1
      },
      "committed": {
        "type": "boolean"
      },
      "files": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "contents": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "contents"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "version",
      "committed",
      "files"
    ],
    "additionalProperties": false
  }
}
