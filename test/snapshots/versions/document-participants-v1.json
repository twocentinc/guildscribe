{
  "contractVersion": 1,
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "schemaVersion": {
        "type": "number",
        "const": 1
      },
      "recordingID": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "participants": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "userID": {
              "type": "string",
              "pattern": "^\\d{17,20}$"
            },
            "username": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "displayName": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "sessions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "startOffsetMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "endOffsetMs": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "startOffsetMs",
                  "endOffsetMs"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "userID",
            "username",
            "displayName",
            "sessions"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "schemaVersion",
      "recordingID",
      "participants"
    ],
    "additionalProperties": false
  }
}
